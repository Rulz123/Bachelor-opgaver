-- Query 1: upcoming trips
select
    t.id,
    t.scheduled_departure_utc,
    t.status
from trips t
where t.route_id = :'route_id'
  and t.status = '1'
  and t.scheduled_departure_utc >= :'after_utc'::timestamptz
order by t.scheduled_departure_utc, t.id
limit 20;

-- Query 2: ordered route stops
select route_stops.route_id, stops.name, route_stops.stop_sequence
from route_stops
join stops on stops.id = route_stops.stop_id
where route_stops.route_id = :'route_id'
order by route_stops.stop_sequence, route_stops.id;

-- Query 3: routes and trip count, including routes with zero trips
SELECT
    routes.id,
    COUNT(t.id) AS trip_count
FROM routes
LEFT JOIN trips t
    ON t.route_id = routes.id
    AND t.service_date = :'service_date'::date
    AND t.status = '1'
GROUP BY routes.id
ORDER BY routes.id;