-- After expansion, use this query to choose a product ID for your test.
select product_id, code, price, currency from products order by code;

-- TODO: Write a function or parameterized insert that accepts a product ID.
-- Look up its code and store both references on the ticket.
-- Use old_writer.sql as a guide to the other required ticket fields.
-- Keep the agreed price as an input; do not copy the current catalogue price.
-- Test an unknown ID and a supplied code belonging to another product.


WITH vars AS (
    SELECT
        :'ticket_id'::text AS ticket_id,
        :'ticket_code'::text AS ticket_code
)
INSERT INTO tickets (
    id,
    user_id,
    trip_id,
    ticket_code,
    status,
    product_code,
    valid_from_utc,
    valid_to_utc,
    price,
    currency,
    product_id
)
SELECT
    vars.ticket_id,
    t.user_id,
    t.trip_id,
    vars.ticket_code,
    t.status,
    (select code from products where product_id = :'product_id'::uuid),
    t.valid_from_utc,
    t.valid_to_utc,
    :'purchase_price'::numeric,
    :'purchase_currency',
    :'product_id'::uuid
FROM tickets t
CROSS JOIN vars
WHERE t.id = 'TICKET-1';