-- Copy to 032_require_ticket_product.sql and complete it.
-- Apply only after retiring old writers and passing final verification.
-- Validate the product-ID foreign key, then require the ticket reference.
-- Rehearse legacy-column removal separately after dependency checks.

BEGIN;

-- Validate existing product_id -> product relationship.
ALTER TABLE tickets
    VALIDATE CONSTRAINT tickets_product_id_fkey;

-- Require every ticket to reference a product.
ALTER TABLE tickets
    ALTER COLUMN product_id SET NOT NULL;

-- Removes old function.
ALTER TABLE tickets
    DROP CONSTRAINT tickets_set_product_id();
COMMIT;