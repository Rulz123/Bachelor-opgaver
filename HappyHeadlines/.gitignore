.vs/
.idea/
*.user
*.suo
*.sln.docstates
# Test results and coverage output
**/TestResults/
*.trx
*.coverage
*.coveragexml
# Generated logs
*.log
# Local environment variables / secrets
.env
.env.*
!.env.example
# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
